# Copier vers .env :  cp .env.example .env   (PowerShell : Copy-Item .env.example .env)
# Remplacer [PROJECT-REF], [REGION], [YOUR-PASSWORD] par les valeurs du tableau Supabase (Connect).

# --- Runtime Next.js + PrismaClient (obligatoire en prod, ex. Vercel) ---
# Pooler mode transaction (port 6543) — idéal serverless / Edge API routes évitées pour Prisma.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- CLI Prisma uniquement (migrate, db push, studio en local / CI) ---
# Session pooler ou URL « direct » :5432 — pas requise sur Vercel pour servir l’app.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Nom affiché sur l’écran de connexion (optionnel, public).
# NEXT_PUBLIC_CABINET_DISPLAY_NAME=Cabinet du Sourire
