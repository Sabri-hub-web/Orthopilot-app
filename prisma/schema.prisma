// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReglementStatus {
  EN_ATTENTE
  EN_RETARD
  RELANCE_ENVOYEE
  PARTIEL
  REGLE
}

enum ReglementSemestre {
  SEMESTRE_1
  SEMESTRE_2
  SEMESTRE_3
  SEMESTRE_4
  CONTENTION
  HORS_SEMESTRE
}

enum TaskPriority {
  FAIBLE
  NORMALE
  IMPORTANTE
  URGENTE
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  BLOQUEE
  EN_ATTENTE
  TERMINEE
}

enum PatientHubStatus {
  ACTIF
  ATTENTION_ADMIN
  ARCHIVE
}

enum UserRole {
  ADMIN
  RESPONSABLE
  SECRETAIRE
  PRATICIEN
  ASSISTANTE
}

enum PresenceStatus {
  DISPONIBLE
  EN_CONSULTATION
  EN_REUNION
  ABSENT
}

model User {
  id             String         @id @default(cuid())
  fullName       String
  email          String         @unique
  passwordHash   String         @default("")
  role           UserRole       @default(SECRETAIRE)
  presenceStatus PresenceStatus @default(DISPONIBLE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignedTasks           Task[]
  sessions                Session[]
  messagesSent            InternalMessage[] @relation("MessageSent")
  messagesReceived        InternalMessage[] @relation("MessageReceived")
  patientCommentsAuthored PatientComment[]  @relation("PatientCommentAuthor")
  patientCommentsReceived PatientComment[]  @relation("PatientCommentRecipient")
}

model Patient {
  id                String           @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  legalGuardian     String?
  nextAppointmentAt DateTime?
  mutuelle          String?
  internalComment   String?
  hubStatus         PatientHubStatus @default(ACTIF)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  reglements Reglement[]
  tasks      Task[]
  comments   PatientComment[]
}

model PatientComment {
  id          String    @id @default(cuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation("PatientCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  recipientId String?
  recipient   User?     @relation("PatientCommentRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  content     String
  isDone      Boolean   @default(false)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId, createdAt])
}

model Reglement {
  id            String            @id @default(cuid())
  amountDue     Float
  dueDate       DateTime
  status        ReglementStatus
  semestre      ReglementSemestre @default(HORS_SEMESTRE)
  comment       String?
  relanceCount  Int               @default(0)
  lastRelanceAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Task {
  id           String       @id @default(cuid())
  title        String
  comment      String?
  dueDate      DateTime
  priority     TaskPriority
  status       TaskStatus
  assignee     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  patientId    String?
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignedUser User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InternalMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  sender      User      @relation("MessageSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User      @relation("MessageReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@index([recipientId, readAt])
}
